# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard (Vite, set in Netlify env) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI Content Generation ---
ANTHROPIC_API_KEY=

# --- Image Service (VPS) ---
IMAGE_SERVICE_URL=
IMAGE_API_KEY=
CHROMIUM_PATH=/usr/bin/chromium
# Comma-separated hostnames allowed for company logos and cover images,
# e.g. zyntern.com,cdn.zyntern.com  (lowercase hostnames only, no scheme, no port)
# NOTE: zyntern.hu only 301-redirects to a shortener, so it is not usable here.
EXTRA_IMAGE_HOSTS=

# --- OAuth (set in Supabase secrets) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OAUTH_REDIRECT_URL=
# Request LinkedIn organization scopes (needs the approved Community Management API
# product). false = post as personal profile.
LINKEDIN_ORG_MODE=false
# Specific Facebook page to connect. Empty = first page from /me/accounts.
FACEBOOK_PAGE_ID=

# --- Security (set in Supabase secrets) ---
CRON_SECRET=
API_AUTH_TOKEN=
DASHBOARD_URL=

# --- Alerting (set in Supabase secrets) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
